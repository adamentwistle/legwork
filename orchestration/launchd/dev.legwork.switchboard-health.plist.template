<?xml version="1.0" encoding="UTF-8"?>
<!--
  Launch agent for orchestration/bin/switchboard-health: one pass every 5 minutes.
  macOS only. On Windows, switchboard-health-ctl registers a Task Scheduler task
  instead, and this file is not used.

  Do not copy this into ~/Library/LaunchAgents: it would load at every login. Use
  orchestration/bin/switchboard-health-ctl on|off|status, which renders it into the
  state directory and loads it only when you ask. RunAtLoad is true, which here means
  "run one pass when the watcher is switched on".

  Placeholders:
    @PYTHON@       the interpreter that ran switchboard-health-ctl, e.g. /usr/bin/python3
    @LEGWORK@      absolute path of the legwork checkout, e.g. ~/src/legwork written out in full
    @STATE_DIR@    the health watcher's state directory, by default
                   $CLAUDE_CONFIG_DIR/switchboard, else ~/.claude/switchboard, written out
                   in full (it must exist before loading: launchd does not create log
                   directories)
    @CLAUDE_BIN@   directory holding the claude binary, from `dirname $(which claude)`
    @ENVIRONMENT@  CLAUDE_CONFIG_DIR and the legwork settings (LEGWORK_DIR, LEGWORK_CONFIG,
                   LEGWORK_SESSION_ARGS) that were set when the watcher was switched on,
                   one key and string each; nothing when none was set

  A launch agent's default PATH is /usr/bin:/bin:/usr/sbin:/sbin, where herdr and
  terminal-notifier are missing, so PATH puts /opt/homebrew/bin first.

  switchboard-health-ctl fills the placeholders itself. By hand, the same plist goes in
  @STATE_DIR@ and is loaded with launchctl bootstrap gui/$(id -u) <that plist>.
-->
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>Label</key>
	<string>dev.legwork.switchboard-health</string>
	<key>ProgramArguments</key>
	<array>
		<string>@PYTHON@</string>
		<string>@LEGWORK@/orchestration/bin/switchboard-health</string>
		<string>--once</string>
		<string>--state-dir</string>
		<string>@STATE_DIR@</string>
	</array>
	<key>EnvironmentVariables</key>
	<dict>
		<key>PATH</key>
		<string>/opt/homebrew/bin:@CLAUDE_BIN@:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
@ENVIRONMENT@
	</dict>
	<key>StartInterval</key>
	<integer>300</integer>
	<key>RunAtLoad</key>
	<true/>
	<key>StandardOutPath</key>
	<string>@STATE_DIR@/health.out.log</string>
	<key>StandardErrorPath</key>
	<string>@STATE_DIR@/health.err.log</string>
</dict>
</plist>
