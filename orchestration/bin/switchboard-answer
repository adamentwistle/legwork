#!/usr/bin/env python3
"""Relay the user's answer or delegation to an orchestrator and record it.

Usage: switchboard-answer REPO PANE ID ANSWER
       switchboard-answer --grant REPO PANE WORDS --scope SCOPE

The first form sends "SWITCHBOARD ANSWER <id>: <answer>" to the pane with
`herdr agent prompt`, then appends "ANSWERED <id>: <answer> (<date>)" to
REPO/.legwork/switchboard.md. It refuses, sending and writing nothing, when
ID is not an open DECISION in that file: no such DECISION, already
ANSWERED, or replaced. Open is decided by switchboard-wait's own parser.

--grant records a delegation: it appends
  ## <project>-gN GRANT <date>
  User: "<words>"
  Scope: <scope>
to the file (N is one more than the GRANT entries already there, project
comes from the ids of the existing entries, else the repo directory name)
and sends "SWITCHBOARD GRANT <project>-gN: <words> (Scope: <scope>)" to the
pane. The g keeps grant ids apart from the orchestrator's own <project>-N.

The answer, words and scope are single arguments passed through byte for
byte: quotes, colons and spaces are kept. A newline (or carriage return) is
refused, because it would submit the prompt early and split the file line.
The date is "YYYY-MM-DD HH:MM", local time. The file is written with LF
line endings, on Windows too.

If herdr fails (including a missing herdr or a 30 s timeout) nothing is
written. The send comes first; the write follows only on success. A lock
per repo (.legwork/switchboard-answer.lock) stops two relays both passing
the open check.

Exit 0 done, 1 refused or failed, 2 bad arguments.
"""
import importlib.machinery
import importlib.util
import os
import re
import subprocess
import sys
import time

HERDR_TIMEOUT = 30
HERE = os.path.dirname(os.path.realpath(__file__))


def load_wait():
    """switchboard-wait's module, for its parser and lock, so both agree on what is open."""
    loader = importlib.machinery.SourceFileLoader(
        "switchboard_wait", os.path.join(HERE, "switchboard-wait"))
    spec = importlib.util.spec_from_loader("switchboard_wait", loader)
    mod = importlib.util.module_from_spec(spec)
    loader.exec_module(mod)
    return mod


def fail(msg, code=1):
    print(f"switchboard-answer: {msg}", file=sys.stderr)
    return code


def bad_text(label, text):
    """An error message when text cannot go on one line, else None."""
    if not text.strip():
        return f"{label} is empty"
    if "\n" in text or "\r" in text:
        return f"{label} has a newline; send it as one line"
    return None


def herdr(*args):
    return subprocess.run(["herdr", *args], capture_output=True, text=True,
                          timeout=HERDR_TIMEOUT)


def send(pane, text):
    """None when herdr took the prompt, else why not."""
    try:
        done = herdr("agent", "prompt", pane, text)
    except subprocess.TimeoutExpired:
        return f"herdr timed out after {HERDR_TIMEOUT} s"
    except OSError as e:
        return f"could not run herdr: {e}"
    if done.returncode != 0:
        detail = (done.stderr or done.stdout).strip()
        return f"herdr failed (exit {done.returncode}) {detail}".strip()
    return None


def append(path, text):
    """Append text, starting a new line first if the file does not end in one."""
    os.makedirs(os.path.dirname(path), exist_ok=True)
    lead = ""
    try:
        with open(path, "rb") as f:
            f.seek(0, os.SEEK_END)
            if f.tell():
                f.seek(-1, os.SEEK_END)
                lead = "" if f.read(1) == b"\n" else "\n"
    except OSError:
        pass
    with open(path, "a", encoding="utf-8", newline="\n") as f:
        f.write(lead + text)


def stamp():
    return time.strftime("%Y-%m-%d %H:%M")


def locked(wait, repo):
    """Hold a per-repo lock so two relays cannot both pass the open check."""
    os.makedirs(os.path.join(repo, ".legwork"), exist_ok=True)
    return wait.exclusive(os.path.join(repo, ".legwork", "switchboard-answer.lock"))


def answer(repo, pane, ident, text):
    err = bad_text("answer", text)
    if err:
        return fail(err, 2)
    wait = load_wait()
    path = os.path.join(repo, ".legwork", "switchboard.md")
    with locked(wait, repo):
        entries, answered = wait.parse(path)
        open_ids = {entries[i][0] for i in wait.reportable(entries, answered, -1, False)
                    if entries[i][1] == "DECISION"}
        if ident not in open_ids:
            return fail(f"{ident} is not an open DECISION in {path}")
        err = send(pane, f"SWITCHBOARD ANSWER {ident}: {text}")
        if err:
            return fail(err)
        append(path, f"ANSWERED {ident}: {text} ({stamp()})\n")
    return 0


GRANT = re.compile(r"^## \S+ GRANT\b", re.M)


def grant(repo, pane, words, scope):
    for label, text in (("words", words), ("scope", scope)):
        err = bad_text(label, text)
        if err:
            return fail(err, 2)
    wait = load_wait()
    path = os.path.join(repo, ".legwork", "switchboard.md")
    with locked(wait, repo):
        try:
            with open(path, encoding="utf-8", errors="replace") as f:
                count = len(GRANT.findall(f.read()))
        except OSError:
            count = 0
        entries = wait.parse(path)[0]
        project = (entries[0][0].rpartition("-")[0] if entries else "") \
            or os.path.basename(repo)
        ident = f"{project}-g{count + 1}"
        err = send(pane, f"SWITCHBOARD GRANT {ident}: {words} (Scope: {scope})")
        if err:
            return fail(err)
        append(path, f'## {ident} GRANT {stamp()}\nUser: "{words}"\nScope: {scope}\n\n')
    return 0


def main(argv):
    if argv[:1] == ["--grant"]:
        if len(argv) != 6 or argv[4] != "--scope":
            return fail("usage: switchboard-answer --grant REPO PANE WORDS --scope SCOPE", 2)
        return grant(os.path.abspath(os.path.expanduser(argv[1])), argv[2], argv[3], argv[5])
    if len(argv) != 4 or argv[0].startswith("--"):
        print(__doc__.strip(), file=sys.stderr)
        return 2
    return answer(os.path.abspath(os.path.expanduser(argv[0])), argv[1], argv[2], argv[3])


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
